{
  "name": "leave-manager",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools/tsconfig.json",
    "test:fast": "TZ=UTC LANG=en_US.UTF-8 vitest run --exclude \"**/*.int.test.ts\" --exclude \"**/node_modules/**\"",
    "test:int": "TZ=UTC LANG=en_US.UTF-8 vitest run .int.test.",
    "test": "TZ=UTC LANG=en_US.UTF-8 vitest run",
    "build": "npm run build --workspaces --if-present",
    "dev": "node tools/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
